# Database Configuration
POSTGRES_DB=lodestone
POSTGRES_USER=lodestone
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_PORT=5432
DB_SSLMODE=require

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password
REDIS_PORT=6379

# Application Ports
API_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# Storage Configuration
STORAGE_TYPE=local
# For S3-compatible storage, uncomment and configure:
# STORAGE_TYPE=s3
# STORAGE_S3_BUCKET=your-bucket-name
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=your-access-key
# STORAGE_S3_SECRET_KEY=your-secret-key
# STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
# STORAGE_S3_FORCE_PATH_STYLE=false
#
# For Azure Blob storage, uncomment and configure:
# STORAGE_TYPE=azure
# STORAGE_AZURE_ACCOUNT_NAME=your-account-name
# STORAGE_AZURE_ACCOUNT_KEY=your-account-key
# STORAGE_AZURE_CONTAINER=lodestone-artifacts
# STORAGE_AZURE_ENDPOINT=https://your-account-name.blob.core.windows.net/
# STORAGE_AZURE_CONNECTION_STRING=

# Authentication & Security
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-32-chars
JWT_EXPIRATION=24h
BCRYPT_COST=12

# Application Configuration
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100

# Registry Features
REGISTRY_ENABLED_FORMATS=npm,nuget,maven,go,helm,cargo,rubygems,opa
MAX_UPLOAD_SIZE=100MB
