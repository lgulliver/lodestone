# Development Environment Configuration
# Copy this to .env for development setup

# Database Configuration
POSTGRES_DB=lodestone
POSTGRES_USER=lodestone
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Redis Configuration  
REDIS_PASSWORD=
REDIS_PORT=6379

# API Gateway Configuration
API_PORT=8080
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRATION=24h
BCRYPT_COST=12

# Storage Configuration
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/artifacts

# Optional: S3-compatible configuration for LocalStack
STORAGE_S3_BUCKET=lodestone-artifacts
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=test
STORAGE_S3_SECRET_KEY=test
STORAGE_S3_ENDPOINT=http://localstack:4566
STORAGE_S3_FORCE_PATH_STYLE=true

# Optional: Azure Blob configuration for Azurite
STORAGE_AZURE_CONTAINER=lodestone-artifacts
STORAGE_AZURE_CONNECTION_STRING=UseDevelopmentStorage=true
STORAGE_AZURE_ENDPOINT=http://azurite:10000/devstoreaccount1

# Development Settings
LOG_LEVEL=debug
LOG_FORMAT=text
DB_SSLMODE=disable

# Security Settings (Development)
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=1000

# Registry Features
REGISTRY_ENABLED_FORMATS=npm,nuget,maven,go,helm,cargo,rubygems,opa
MAX_UPLOAD_SIZE=100MB

# Development URLs
BASE_URL=http://localhost:8080
